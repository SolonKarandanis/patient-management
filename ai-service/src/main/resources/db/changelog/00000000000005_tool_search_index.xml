<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <!-- Dedicated pgvector table for ToolSearchToolCallingAdvisor's VectorToolIndex.
         Kept separate from vector_store so tool-reference embeddings never surface
         in the clinical-knowledge RAG similarity search (QuestionAnswerAdvisor /
         AiServiceMcpTools#searchClinicalKnowledge), which has no metadata filter. -->
    <changeSet id="00000000000005-tool-search-index" author="solonk">
        <createTable tableName="tool_search_index">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="content" type="text"/>
            <column name="metadata" type="jsonb"/>
            <column name="embedding" type="vector(768)"/>
        </createTable>
    </changeSet>

    <changeSet id="00000000000005-tool-search-index-idx" author="solonk">
        <sql>
            CREATE INDEX IF NOT EXISTS tool_search_index_embedding_idx
            ON tool_search_index USING hnsw (embedding vector_cosine_ops)
        </sql>
    </changeSet>

</databaseChangeLog>
